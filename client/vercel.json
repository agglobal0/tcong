{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://tcong.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://tcong.onrender.com/uploads/:path*" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
